# rpg maker files
file*.rmmzsave

# save slots under the codec save format, which writes a directory of retained generations per slot
# rather than one file. config.json stays tracked, matching config.rmmzsave above it.
**/save/file*/

# invisible OS configuration files
.DS_Store
desktop.ini

# user directories
.vs
.vscode
.idea
*.DotSettings.user

# dependencies
node_modules

# editor backups / autosaves (Krita, gedit/vim tilde files, etc.)
*-autosave.kra
*~

# database backups taken before a risky edit; keep them locally, never in history.
*.old.json
*.backup*
*.bak*
# generated maps awaiting review; tools/mapgen/install.js is what moves them into data/
tools/mapgen/.staging/
